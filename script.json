  "vo": [
    { "id": "v01", "szene": "s1_nacht",     "text": "Drei Uhr zwölf. Die Stadt schläft. Ihr Büro ist dunkel." },
    { "id": "v02", "szene": "s1_nacht",     "text": "Aber Ihre IT schläft nie: Website, Firewall, Server, Backups." },
    { "id": "v03", "szene": "s1_nacht",     "text": "Die Frage ist nur: Weckt sie heute Nacht jemanden?" },
    { "id": "v04", "szene": "s2_website",   "text": "Fangen wir vorne an, bei Ihrer Website. Sie ist Ihr Schaufenster, auch um drei Uhr nachts." },
    { "id": "v05", "szene": "s2_website",   "text": "Wir bauen sie für Sie. Komplett programmiert. Kein Baukasten, keine Plugin-Sammlung, keine Vorlage von der Stange." },
    { "id": "v06", "szene": "s2_website",   "text": "Sie lädt in unter einer Sekunde, liegt auf Servern in Deutschland und wird jeden Tag gesichert." },
    { "id": "v07", "szene": "s2_website",   "text": "Und Sie zahlen monatlich: Hosting, Updates und Pflege für einen festen Betrag, ohne Überraschungen." },
    { "id": "v08", "szene": "s2_website",   "text": "Der Quellcode gehört trotzdem Ihnen." },
    { "id": "v09", "szene": "s3_netz",      "text": "Hinter der Website beginnt Ihr Netzwerk. Dort entscheidet sich, ob ein Angreifer draußen bleibt." },
    { "id": "v10", "szene": "s3_netz",      "text": "Wir richten Ihre Firewall ein, mit FortiGate oder OPNsense, herstellerneutral und aus dem täglichen Betrieb." },
    { "id": "v11", "szene": "s3_netz",      "text": "Und der Zugriff aus dem Homeoffice läuft ohne klassisches VPN. Mit Zero Trust ist Ihr Firmennetz im Internet schlicht unsichtbar. Es gibt keinen offenen Port, den man scannen könnte." },
    { "id": "v12", "szene": "s4_ernstfall", "text": "Und wenn doch etwas passiert? Ransomware greift zuerst die Sicherungen an." },
    { "id": "v13", "szene": "s4_ernstfall", "text": "Darum legen wir unveränderbare Kopien an und spielen sie regelmäßig zurück. Denn ein Backup, das nie getestet wurde, ist nur eine Hoffnung." },
    { "id": "v14", "szene": "s5_betrieb",   "text": "Ihre VMware-Lizenz kostet plötzlich ein Vielfaches? Wir ziehen Ihre Server auf Proxmox um, planbar, mit Testlauf und Rückweg." },
    { "id": "v15", "szene": "s5_betrieb",   "text": "Updates spielen wir im laufenden Betrieb ein, mit Dashboards, die man auch ohne IT-Studium lesen kann." },
    { "id": "v16", "szene": "s6_beweis",    "text": "Klingt nach Prospekt? Ist es nicht. Wir betreiben selbst, was wir Ihnen empfehlen." },
    { "id": "v17", "szene": "s6_beweis",    "text": "Was Sie hier sehen, ist kein Mockup. Das ist unser eigenes Monitoring, live und im Dauerbetrieb." },
    { "id": "v18", "szene": "s7_team",      "text": "Und das alles kommt von einem Team, von der Website bis zur Firewall." },
    { "id": "v19", "szene": "s7_team",      "text": "Kein Callcenter, kein Ticketstapel. Sie sprechen mit den Leuten, die Ihre Systeme bauen, und bekommen innerhalb eines Werktags eine Antwort." },
    { "id": "v20", "szene": "s7_team",      "text": "Am Ende gehört Ihnen die komplette Dokumentation. Keine Black Box, keine Abhängigkeit." },
    { "id": "v21", "szene": "s8_morgen",    "text": "Sieben Uhr. Alles läuft. Niemand wurde geweckt." },
    { "id": "v22", "szene": "s8_morgen",    "text": "nomissuccess. Infrastruktur, die nachts niemanden weckt." },
    { "id": "v23", "szene": "s8_morgen",    "text": "Das Erstgespräch dauert dreißig Minuten und kostet nichts. nomissuccess punkt de." }
  ],
